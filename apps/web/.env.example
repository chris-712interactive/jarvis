# Optional. Defaults to apps/web/data/jarvis.db
# Requires Node 22+ (Railway Dockerfile uses Node 24). Built-in node:sqlite — no better-sqlite3.
# JARVIS_DB_PATH=/absolute/path/to/jarvis.db

# Required for Phase 2 chat (operator uplink)
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional. Improves GitHub rate limits and unlocks private repos for
# get_repo_summary / list_open_prs (and GET /api/projects/:id/github).
# GITHUB_TOKEN=ghp_...

# Required for code jobs (Cursor Cloud Agents as workers).
# Create at Cursor Dashboard → API Keys: https://cursor.com/dashboard/api
# CURSOR_API_KEY=key_...
# Optional Cloud Agent knobs:
# CURSOR_AGENT_MODEL=composer-2
# CURSOR_AGENT_MODE=agent
# CURSOR_AGENT_AUTO_PR=true
# CURSOR_AGENT_STARTING_REF=main

# Google Analytics 4 (per-lane reads via get_lane_analytics / GET .../analytics).
# Create a GCP service account, enable Analytics Data API, download JSON key,
# and add the service account email as Viewer on each GA4 property.
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Or path form (also accepts GOOGLE_APPLICATION_CREDENTIALS):
# GA4_SERVICE_ACCOUNT_PATH=/absolute/path/to/sa.json

# Google Search Console (per-lane SEO via get_lane_search / GET .../search-console).
# Same service account works if you also:
# 1) Enable "Google Search Console API" on the GCP project
# 2) Add the SA email as a user on each Search Console property
# Optional override JSON (otherwise reuses GA4_* / GOOGLE_APPLICATION_CREDENTIALS):
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Per lane: set gscSiteUrl to sc-domain:example.com or https://example.com/

# Production deploy / health (per-lane via get_lane_deploy / GET .../deploy).
# Per lane: set productionUrl (https://…) and optional deployHost + deployProjectId.
# deployHost: url | vercel | railway | aws
# - url/aws: HTTP health check on productionUrl (AWS is URL-health in v1)
# - vercel: also set VERCEL_TOKEN (+ optional VERCEL_TEAM_ID); deployProjectId = project id or name
# - railway: also set RAILWAY_TOKEN; deployProjectId = Railway service id
# VERCEL_TOKEN=...
# VERCEL_TEAM_ID=team_...
# RAILWAY_TOKEN=...

# Gmail (inbound email → code jobs → approve → reply).
# 1) Google Cloud → OAuth client (Web application)
# 2) Authorized redirect: http://localhost:3000/api/gmail/oauth/callback
# 3) Enable Gmail API
# 4) Set client id/secret, visit /api/gmail/oauth/start, copy refresh token
# GMAIL_CLIENT_ID=....apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# Optional override if not using localhost callback:
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# Protects cron routes (/api/cron/tick, /briefing, /daily-content, /email-ingest).
# Required in production. Send Authorization: Bearer <secret> (or ?secret=)
# CRON_SECRET=change-me

# Operator timezone + briefing windows for /api/cron/tick (local hours).
# BRIEFING_TZ=America/Chicago
# BRIEFING_MORNING_HOUR=7
# BRIEFING_EVENING_HOUR=18

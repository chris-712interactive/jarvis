# Optional. Defaults to apps/web/data/jarvis.db
# JARVIS_DB_PATH=/absolute/path/to/jarvis.db

# Required for Phase 2 chat (operator uplink)
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional. Improves GitHub rate limits and unlocks private repos for
# get_repo_summary / list_open_prs (and GET /api/projects/:id/github).
# GITHUB_TOKEN=ghp_...

# Required for code jobs (Cursor Cloud Agents as workers).
# Create at Cursor Dashboard → API Keys: https://cursor.com/dashboard/api
# CURSOR_API_KEY=key_...
# Optional Cloud Agent knobs:
# CURSOR_AGENT_MODEL=composer-2
# CURSOR_AGENT_MODE=agent
# CURSOR_AGENT_AUTO_PR=true
# CURSOR_AGENT_STARTING_REF=main

# Google Analytics 4 (per-lane reads via get_lane_analytics / GET .../analytics).
# Create a GCP service account, enable Analytics Data API, download JSON key,
# and add the service account email as Viewer on each GA4 property.
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Or path form (also accepts GOOGLE_APPLICATION_CREDENTIALS):
# GA4_SERVICE_ACCOUNT_PATH=/absolute/path/to/sa.json

# Protects POST/GET /api/cron/daily-content (queue Skool/content drafts).
# Required in production. Send Authorization: Bearer <secret>
# CRON_SECRET=change-me
